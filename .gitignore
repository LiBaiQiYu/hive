# 依赖与构建缓存
node_modules/
dist/
*.tsbuildinfo

# Cloudflare 本地状态：包含本地 D1 数据，绝不入仓
.wrangler/

# 本地密钥（假值，但也不该进仓库）
.dev.vars
.env
.env.*

# 邀请码清单、数据库导出：属于凭据，只留在本地
backups/
*.sqlite
*.sqlite3

# 杂项
*.log
.DS_Store
Thumbs.db
# 本地预览产物（截图 / 抓帧），不入库
.preview/
.shots/
.holo2/
.audit/
# 无头浏览器的工作目录与临时产物（截图脚本跑完会留下一堆）
apps/web/.chrome-tmp/
apps/web/.tmp-edge-*/
apps/web/tmp-*.html
apps/web/tmp-*.png
apps/web/tmp-*.py
# pnpm 在项目所在盘建的本地 store（`pnpm add` 会顺手生成，几十万个文件）
.pnpm-store/
