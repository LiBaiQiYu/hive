# ---------------------------------------------------------------------------
# HIVE —— 自建服务器运行期环境变量模板
#
# 这个文件的内容最终会变成服务器上的 /opt/hive/shared/.env（权限 600）。
# 里面的值**不进 Git**：仓库里只保留这个模板。
# ---------------------------------------------------------------------------

# ---- 必填 -----------------------------------------------------------------

# 对外访问地址（含协议，不要结尾斜杠）。
# Steam OpenID 的 realm / return_to 都由它推导；也决定 Cookie 要不要加 Secure。
APP_ORIGIN=https://hive.example.com

# 密码哈希的 pepper。**改它 = 所有现有密码失效**（哈希里带 p1 版本号，
# 将来换 pepper 要走双 pepper 过渡，不能直接替换）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PASSWORD_PEPPER=

# IP 哈希盐：审计日志只存 ip_hash，不存明文 IP。
# 生成方式同上。
IP_HASH_SALT=

# ---- 出站邮件（可选，不填则只记审计不发信）---------------------------------

SMTP_HOST=
# 465 = 隐式 TLS（SMTP_SECURE=true）；587 = STARTTLS（SMTP_SECURE=false）
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# QQ 邮箱要填「授权码」，不是登录密码
SMTP_PASS=
# 发件地址；留空则回落到 SMTP_USER
SMTP_FROM=
SMTP_FROM_NAME=HIVE

# ---- 可选（下面都是代码里的默认值，一般不用改）-----------------------------

APP_ENV=production
SESSION_TTL_DAYS=14
SESSION_IDLE_TIMEOUT_HOURS=72
# 自建机器没有 Workers 的 10ms CPU 限制，迭代次数可以比线上更高
PASSWORD_PBKDF2_ITERATIONS=120000
ADMIN_ADJUSTMENT_LIMIT=150
AUTO_FINALIZE_ODD=false
STEAM_WEB_API_KEY=
STRATZ_API_TOKEN=
AUDIT_RETENTION_DAYS=365

# 密码找回走哪条路。留空 = 配了 SMTP 就用 self，否则 admin。
#   self  —— 登录页填邮箱，系统直接发信（自建推荐）
#   admin —— 只显示"联系管理员"
RESET_FLOW=
